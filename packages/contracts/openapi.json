  },
  "info": {
    "title": "Bora API",
    "description": "API do Bora (OiTenta). Contrato usado pelo web e pelo mobile.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterUserBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Ana Souza"
          },
          "email": {
            "type": "string",
            "example": "ana@bora.app"
          },
          "password": {
            "type": "string",
            "example": "Senha@123",
            "description": "Mínimo 8 caracteres, com maiúscula, minúscula, número e símbolo."
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "PublicUserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email"
        ]
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/PublicUserResponse"
          }
        },
        "required": [
          "user"
        ]
      },
      "LoginUserBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ana@bora.app"
          },
          "password": {
            "type": "string",
            "example": "Senha@123"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT. Envie como Authorization: Bearer <token>."
          },
          "user": {
            "$ref": "#/components/schemas/PublicUserResponse"
          }
        },
        "required": [
          "token",
          "user"
        ]
      }
    }
  }
}
