{
  "openapi": "3.0.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "AppController_getHello",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "App"
        ]
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterUserBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "409": {
            "description": "E-mail já cadastrado."
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginUserBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Credenciais inválidas."
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/demo": {
      "post": {
        "operationId": "AuthController_demo",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "404": {
            "description": "Usuário demo ainda não semeado."
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/goals/{goalId}": {
      "get": {
        "operationId": "GoalsController_getGoal",
        "parameters": [
          {
            "name": "goalId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetGoalResponse"
                }
              }
            }
          },
          "400": {
            "description": "goalId não é um UUID."
          },
          "401": {
            "description": "Token ausente, inválido ou expirado."
          },
          "404": {
            "description": "Objetivo inexistente ou de outro usuário."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "goals"
        ]
      }
    },
    "/scheduling/availability": {
      "get": {
        "operationId": "SchedulingController_getAvailability",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeeklyAvailabilityResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado."
          },
          "404": {
            "description": "O usuário ainda não fez o onboarding."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "scheduling"
        ]
      },
      "put": {
        "operationId": "SchedulingController_setAvailability",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetWeeklyAvailabilityBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeeklyAvailabilityResponse"
                }
              }
            }
          },
          "400": {
            "description": "Corpo malformado ou campo não previsto."
          },
          "401": {
            "description": "Token ausente, inválido ou expirado."
          },
          "422": {
            "description": "Zero janelas, janela inválida ou limite fora de 60–480 / não múltiplo de 30."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "scheduling"
        ]
      }
    },
    "/activation": {
      "get": {
        "operationId": "ActivationController_getActivation",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "Activation"
        ]
      }
    },
    "/gamification": {
      "get": {
        "operationId": "GamificationController_getGamification",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "Gamification"
        ]
      }
    },
    "/notifications": {
      "get": {
        "operationId": "NotificationsController_getNotifications",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "Notifications"
        ]
      }
    }
  },
  "info": {
    "title": "Bora API",
    "description": "API do Bora (OiTenta). Contrato usado pelo web e pelo mobile.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterUserBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Ana Souza"
          },
          "email": {
            "type": "string",
            "example": "ana@bora.app"
          },
          "password": {
            "type": "string",
            "example": "Senha@123",
            "description": "Mínimo 8 caracteres, com maiúscula, minúscula, número e símbolo."
          },
          "timezone": {
            "type": "string",
            "example": "America/Sao_Paulo",
            "description": "Fuso IANA do usuário. Padrão: America/Sao_Paulo."
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "PublicUserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "timezone": {
            "type": "string",
            "example": "America/Sao_Paulo"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "timezone"
        ]
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/PublicUserResponse"
          }
        },
        "required": [
          "user"
        ]
      },
      "LoginUserBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ana@bora.app"
          },
          "password": {
            "type": "string",
            "example": "Senha@123"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT. Envie como Authorization: Bearer <token>."
          },
          "user": {
            "$ref": "#/components/schemas/PublicUserResponse"
          }
        },
        "required": [
          "token",
          "user"
        ]
      },
      "GoalHeaderResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "example": "TCC"
          },
          "deadline": {
            "type": "string",
            "nullable": true,
            "example": "2026-12-15",
            "description": "Data local YYYY-MM-DD."
          },
          "kind": {
            "type": "string",
            "enum": [
              "goal",
              "single"
            ]
          },
          "colorIndex": {
            "type": "number",
            "enum": [
              1,
              2,
              3,
              4
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "manual",
              "ai"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "done"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "deadline",
          "kind",
          "colorIndex",
          "source",
          "status"
        ]
      },
      "StepResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "order": {
            "type": "number",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "Ler os artigos"
          },
          "estimatedMinutes": {
            "type": "number",
            "example": 60
          },
          "aiEstimatedMinutes": {
            "type": "number",
            "nullable": true
          },
          "progressPct": {
            "type": "number",
            "example": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "done",
              "superseded"
            ]
          },
          "microSteps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "remainingMinutes": {
            "type": "number",
            "example": 60,
            "description": "Minutos restantes, arredondados para cima em blocos de 15."
          }
        },
        "required": [
          "id",
          "order",
          "title",
          "estimatedMinutes",
          "aiEstimatedMinutes",
          "progressPct",
          "status",
          "microSteps",
          "remainingMinutes"
        ]
      },
      "GetGoalResponse": {
        "type": "object",
        "properties": {
          "goal": {
            "$ref": "#/components/schemas/GoalHeaderResponse"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StepResponse"
            }
          },
          "progressPct": {
            "type": "number",
            "example": 0
          },
          "done": {
            "type": "number",
            "example": 0
          },
          "total": {
            "type": "number",
            "example": 2
          }
        },
        "required": [
          "goal",
          "steps",
          "progressPct",
          "done",
          "total"
        ]
      },
      "AvailabilityWindowBody": {
        "type": "object",
        "properties": {
          "weekday": {
            "type": "number",
            "example": 0,
            "description": "0 = segunda … 6 = domingo."
          },
          "startMinute": {
            "type": "number",
            "example": 1140,
            "description": "Minutos desde 00:00 (local)."
          },
          "endMinute": {
            "type": "number",
            "example": 1380,
            "description": "Minutos desde 00:00 (local)."
          }
        },
        "required": [
          "weekday",
          "startMinute",
          "endMinute"
        ]
      },
      "WeeklyAvailabilityView": {
        "type": "object",
        "properties": {
          "windows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AvailabilityWindowBody"
            }
          },
          "dailyLimitMinutes": {
            "type": "number",
            "example": 180
          }
        },
        "required": [
          "windows",
          "dailyLimitMinutes"
        ]
      },
      "WeeklyAvailabilityResponse": {
        "type": "object",
        "properties": {
          "availability": {
            "$ref": "#/components/schemas/WeeklyAvailabilityView"
          }
        },
        "required": [
          "availability"
        ]
      },
      "SetWeeklyAvailabilityBody": {
        "type": "object",
        "properties": {
          "windows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AvailabilityWindowBody"
            }
          },
          "dailyLimitMinutes": {
            "type": "number",
            "example": 180,
            "description": "Limite diário em minutos: de 60 a 480, múltiplo de 30."
          }
        },
        "required": [
          "windows",
          "dailyLimitMinutes"
        ]
      }
    }
  }
}
