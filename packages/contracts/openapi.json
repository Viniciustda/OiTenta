    "/activation/ramp": {
      "get": {
        "operationId": "RampController_getRamp",
        "parameters": [
          {
            "name": "goalId",
            "required": true,
            "in": "query",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "stepId",
            "required": true,
            "in": "query",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "energy",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "electric"
              ]
            }
          },
          {
            "name": "availableTime",
            "required": false,
            "in": "query",
            "description": "Só gravado na sessão nesta fase (P15); o web não envia.",
            "schema": {
              "type": "string",
              "enum": [
                "15m",
                "30m",
                "1h",
                "2h+"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RampResponse"
                }
              }
            }
          },
          "400": {
            "description": "goalId/stepId não são UUID ou energy/availableTime inválidos."
          },
          "401": {
            "description": "Token ausente, inválido ou expirado."
          },
          "404": {
            "description": "Objetivo ou etapa inexistente ou de outro usuário."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "activation"
        ]
      }
    },
    "/activation/sessions": {
      "post": {
        "operationId": "SessionsController_record",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordSessionBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordSessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Corpo malformado ou campo não previsto."
          },
          "401": {
            "description": "Token ausente, inválido ou expirado."
          },
          "404": {
            "description": "Objetivo, etapa ou bloco inexistente ou de outro usuário (nada é gravado)."
          },
          "422": {
            "description": "partial sem %, entre outras regras da sessão."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "activation"
        ]
      }
    }
  },
  "info": {
    "title": "Bora API",
    "description": "API do Bora (OiTenta). Contrato usado pelo web e pelo mobile.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterUserBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Ana Souza"
          },
          "email": {
            "type": "string",
            "example": "ana@bora.app"
          },
          "password": {
            "type": "string",
            "example": "Senha@123",
            "description": "Mínimo 8 caracteres, com maiúscula, minúscula, número e símbolo."
          },
          "timezone": {
            "type": "string",
            "example": "America/Sao_Paulo",
            "description": "Fuso IANA do usuário. Padrão: America/Sao_Paulo."
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "PublicUserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "timezone": {
            "type": "string",
            "example": "America/Sao_Paulo"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "timezone"
        ]
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/PublicUserResponse"
          }
        },
        "required": [
          "user"
        ]
      },
      "LoginUserBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ana@bora.app"
          },
          "password": {
            "type": "string",
            "example": "Senha@123"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT. Envie como Authorization: Bearer <token>."
          },
          "user": {
            "$ref": "#/components/schemas/PublicUserResponse"
          }
        },
        "required": [
          "token",
          "user"
        ]
      },
      "AvailabilityWindowBody": {
        "type": "object",
        "properties": {
          "weekday": {
            "type": "number",
            "example": 0,
            "description": "0 = segunda … 6 = domingo."
          },
          "startMinute": {
            "type": "number",
            "example": 1140,
            "description": "Minutos desde 00:00 (local)."
          },
          "endMinute": {
            "type": "number",
            "example": 1380,
            "description": "Minutos desde 00:00 (local)."
          }
        },
        "required": [
          "weekday",
          "startMinute",
          "endMinute"
        ]
      },
      "WeeklyAvailabilityView": {
        "type": "object",
        "properties": {
          "windows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AvailabilityWindowBody"
            }
          },
          "dailyLimitMinutes": {
            "type": "number",
            "example": 180
          }
        },
        "required": [
          "windows",
          "dailyLimitMinutes"
        ]
      },
      "WeeklyAvailabilityResponse": {
        "type": "object",
        "properties": {
          "availability": {
            "$ref": "#/components/schemas/WeeklyAvailabilityView"
          }
        },
        "required": [
          "availability"
        ]
      },
      "SetWeeklyAvailabilityBody": {
        "type": "object",
        "properties": {
          "windows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AvailabilityWindowBody"
            }
          },
          "dailyLimitMinutes": {
            "type": "number",
            "example": 180,
            "description": "Limite diário em minutos: de 60 a 480, múltiplo de 30."
          }
        },
        "required": [
          "windows",
          "dailyLimitMinutes"
        ]
      },
      "PlanGoalResponse": {
        "type": "object",
        "properties": {
          "goalId": {
            "type": "string",
            "format": "uuid"
          },
          "feasible": {
            "type": "boolean",
            "example": true
          },
          "usedSlack": {
            "type": "boolean",
            "example": true,
            "description": "true quando o plano manteve a folga antes do prazo."
          },
          "slackDays": {
            "type": "number",
            "nullable": true,
            "example": 1,
            "description": "Dias de folga mantidos; null para objetivo sem prazo."
          },
          "scheduledMinutes": {
            "type": "number",
            "example": 495
          },
          "unscheduledMinutes": {
            "type": "number",
            "example": 0
          }
        },
        "required": [
          "goalId",
          "feasible",
          "usedSlack",
          "slackDays",
          "scheduledMinutes",
          "unscheduledMinutes"
        ]
      },
      "PlanResponse": {
        "type": "object",
        "properties": {
          "totalMinutes": {
            "type": "number",
            "example": 495
          },
          "days": {
            "type": "number",
            "example": 6
          },
          "goals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlanGoalResponse"
            }
          }
        },
        "required": [
          "totalMinutes",
          "days",
          "goals"
        ]
      },
      "SetAvailabilityResponse": {
        "type": "object",
        "properties": {
          "availability": {
            "$ref": "#/components/schemas/WeeklyAvailabilityView"
          },
          "plan": {
            "$ref": "#/components/schemas/PlanResponse"
          }
        },
        "required": [
          "availability",
          "plan"
        ]
      },
      "GoalDraftBody": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "example": "Trabalho de Algoritmos — implementar e comparar 3 algoritmos de ordenação, entrega 24/11",
            "description": "Texto livre do usuário, 1–2000 caracteres."
          }
        },
        "required": [
          "text"
        ]
      },
      "GoalDraftStepResponse": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Ler o enunciado e listar requisitos"
          },
          "estimatedMinutes": {
            "type": "number",
            "example": 30,
            "description": "Múltiplo de 15, de 15 a 240."
          },
          "aiEstimatedMinutes": {
            "type": "number",
            "example": 30,
            "description": "Estimativa da IA; vai no POST /goals como aiEstimatedMinutes."
          },
          "microSteps": {
            "example": [
              "Abra o enunciado"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "title",
          "estimatedMinutes",
          "aiEstimatedMinutes",
          "microSteps"
        ]
      },
      "GoalDraftResponse": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "nullable": true,
            "example": "Trabalho de Algoritmos"
          },
          "deadline": {
            "type": "string",
            "nullable": true,
            "example": "2026-11-24"
          },
          "category": {
            "type": "string",
            "enum": [
              "assignment",
              "exam",
              "project",
              "generic"
            ]
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missingFields": {
            "type": "array",
            "description": "Informativo (IA2): a tela mostra o campo vazio.",
            "items": {
              "type": "string",
              "enum": [
                "title",
                "deadline"
              ]
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GoalDraftStepResponse"
            }
          },
          "totalMinutes": {
            "type": "number",
            "example": 300
          }
        },
        "required": [
          "title",
          "deadline",
          "category",
          "requirements",
          "missingFields",
          "steps",
          "totalMinutes"
        ]
      },
      "DraftGoalResponse": {
        "type": "object",
        "properties": {
          "draft": {
            "$ref": "#/components/schemas/GoalDraftResponse"
          },
          "engine": {
            "type": "string",
            "enum": [
              "llm",
              "rules"
            ],
            "description": "Quem respondeu; nenhuma tela depende disso."
          }
        },
        "required": [
          "draft",
          "engine"
        ]
      },
      "CreateGoalStepBody": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Ler o enunciado e listar requisitos"
          },
          "estimatedMinutes": {
            "type": "number",
            "example": 30,
            "description": "Mínimo 15, múltiplo de 15 (P5)."
          },
          "aiEstimatedMinutes": {
            "type": "number",
            "nullable": true,
            "example": 30,
            "description": "Estimativa original da IA (D 4f, IA1): mínimo 15, múltiplo de 15; null no objetivo manual."
          },
          "microSteps": {
            "description": "Textos do micro-passo (P6).",
