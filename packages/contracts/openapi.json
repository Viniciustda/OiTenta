    "/goals/assistant/draft": {
      "post": {
        "operationId": "GoalAssistantController_draft",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoalDraftBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rascunho gerado. Não grava nada; quem grava é o POST /goals.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftGoalResponse"
                }
              }
            }
          },
          "400": {
            "description": "text ausente ou não string; campo não previsto."
          },
          "401": {
            "description": "Token ausente, inválido ou expirado."
          },
          "422": {
            "description": "text vazio ou com mais de 2000 caracteres."
          },
          "503": {
            "description": "IA indisponível, lenta ou com saída inválida e AI_FALLBACK=none."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "goals"
        ]
      }
    },
