{
  "name": "@oitenta/oitenta",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "ts-node": "^10.9.2",
    "turbo": "^2.11.10",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.12.1"
    }
  },
  "workspaces": [
    "apps/*",
    "modules/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
