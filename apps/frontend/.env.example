# Copie para .env.local e ajuste. Nunca versione um .env real.

# Base do backend NestJS. Padrão: http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Fonte dos dados das telas: "http" (backend real, padrão) ou "example" (dados em memória do protótipo,
# relógio fixo em 16/11/2026 19:40). Os testes do Vitest usam "example" (vitest.config.ts).
NEXT_PUBLIC_DATA_SOURCE=http
