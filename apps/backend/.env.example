DB_HOST="localhost"
DB_PORT="6435"
DB_USER="oitenta_oitenta"
DB_PASSWORD="docker"
DB_NAME="oitenta_oitenta_db"
DATABASE_URL="postgresql://oitenta_oitenta:docker@localhost:6435/oitenta_oitenta_db?schema=public"
PORT="4000"

# Auth
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
JWT_EXPIRES_IN="1d"
DEMO_EMAIL="demo@bora.app"
DEMO_PASSWORD="troque-por-uma-senha-forte"

# Assistente do novo objetivo (docs/4-contrato-api.md §3; decisões IA1 e IA6)
# AI_PROVIDER: rules (motor de regras, sem rede; padrão) | openai-compatible (Groq, Ollama, OpenRouter...)
AI_PROVIDER="rules"
# Só com openai-compatible. Ex.: Ollama local http://localhost:11434/v1 ; Groq https://api.groq.com/openai/v1
AI_BASE_URL=""
AI_MODEL=""
# Segredo: só no .env (nunca no git). Vazio para o Ollama local.
AI_API_KEY=""
# Orçamento total do rascunho (as duas chamadas), em milissegundos
AI_TIMEOUT_MS="15000"
# rules: a IA falhou ou demorou → rascunho do motor de regras | none: 503 → o app abre o formulário manual (4f)
# Padrão provisório até a reunião de 13/11 (IA6)
AI_FALLBACK="rules"
# true só em desenvolvimento: põe o texto do usuário e a resposta da IA no log
AI_LOG_CONTENT="false"
