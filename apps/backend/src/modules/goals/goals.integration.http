@baseUrl = http://localhost:4000
@scenarioVersion = {{$timestamp}}
@password = Senha@123
# Id de um objetivo do usuário logado em "login". Até o POST /goals (C4), crie-o pelo
# CreateGoal (ver apps/backend/test/goals.e2e-spec.ts) e cole o id aqui.
@goalId = 00000000-0000-4000-8000-000000000000

### Cadastro do dono → 201
# @name register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Ana Souza",
  "email": "goals.dono.{{scenarioVersion}}@bora.app",
  "password": "{{password}}"
}

### Login do dono → 200 com token
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{register.request.body.$.email}}",
  "password": "{{password}}"
}

### Cadastro de outro usuário → 201
# @name registerOther
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Bruno Lima",
  "email": "goals.outro.{{scenarioVersion}}@bora.app",
  "password": "{{password}}"
}

### Login do outro usuário → 200 com token
# @name loginOther
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{registerOther.request.body.$.email}}",
  "password": "{{password}}"
}

### Objetivo do dono → 200 { goal, steps[…remainingMinutes], progressPct, done, total }
GET {{baseUrl}}/goals/{{goalId}}
Authorization: Bearer {{login.response.body.$.token}}

### Objetivo do dono pedido por outro usuário → 404
GET {{baseUrl}}/goals/{{goalId}}
Authorization: Bearer {{loginOther.response.body.$.token}}

### Objetivo inexistente → 404
GET {{baseUrl}}/goals/11111111-1111-4111-8111-111111111111
Authorization: Bearer {{login.response.body.$.token}}

### Sem token → 401
GET {{baseUrl}}/goals/{{goalId}}

### Token inválido → 401
GET {{baseUrl}}/goals/{{goalId}}
Authorization: Bearer token-invalido

### Id malformado (não UUID) → 400
GET {{baseUrl}}/goals/nao-e-uuid
Authorization: Bearer {{login.response.body.$.token}}
