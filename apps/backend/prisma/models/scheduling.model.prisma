// Módulo scheduling: entidades de modules/scheduling/src (availability, plan).
// Commitment não tem tabela nesta fase (decisão P8).
// Blocos referenciam objetivo e etapa só por id, sem FK entre módulos (D 4d).

model WeeklyAvailability {
  id                String    @id @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  windows           Json
  dailyLimitMinutes Int       @map("daily_limit_minutes")
  createdAt         DateTime  @map("created_at")
  updatedAt         DateTime  @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  user              User      @relation(fields: [userId], references: [id])

  @@map("weekly_availabilities")
}

model ScheduledBlock {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  goalId    String    @map("goal_id") @db.Uuid
  stepId    String    @map("step_id") @db.Uuid
  start     DateTime
  end       DateTime
  status    String
  pinned    Boolean
  origin    String
  createdAt DateTime  @map("created_at")
  updatedAt DateTime  @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, start])
  @@map("scheduled_blocks")
}
