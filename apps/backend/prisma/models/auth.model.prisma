// Módulo auth: entidades de modules/auth/src/user/model

model User {
  id        String    @id @db.Uuid
  name      String
  email     String    @unique
  password  String
  createdAt DateTime  @map("created_at")
  updatedAt DateTime  @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("users")
}
